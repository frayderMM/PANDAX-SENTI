# SENTI — configuración del stack
# Copiar a .env y ajustar. NUNCA se commitea .env (§28).

# ─────────────────────────────────────────────────────────────
# Modelo local — LM Studio / llama.cpp (contrato OpenAI)
# ─────────────────────────────────────────────────────────────
# Perfil `llm-host`  → LM Studio corriendo en el host (como hoy).
# Perfil `llm-cuda`  → llama.cpp server-cuda en contenedor, mismo GGUF.
# En ambos casos el backend habla el MISMO dialecto OpenAI, así que
# mover de uno a otro es cambiar esta URL y nada más.
SENTI_LLM_BASE_URL=http://llama-cpu:1234/v1
SENTI_LLM_API_KEY=lm-studio
SENTI_LLM_MODEL=google/gemma-4-e4b
# El agrupamiento de eventos es determinista; Gemma puede reservarse para
# chat/análisis. Si se usa un modelo pequeño para propuestas, configúralo aquí.
CITIZEN_REPORT_GROUP_RADIUS_METERS=500
CITIZEN_REPORT_GROUP_TIME_HOURS=6
CITIZEN_REPORT_MIN_TEXT_SIMILARITY=0.65
SENTI_LLM_CONTEXT_LENGTH=8192
SENTI_LLM_MAX_TOKENS=80
# El turno en que el modelo elige herramienta necesita más fichas que el turno
# en que redacta: si se trunca el JSON de la llamada, la herramienta se pierde
# sin dar error y el modelo acaba pidiendo datos que ya tenía.
SENTI_LLM_TOOL_MAX_TOKENS=512
SENTI_LLM_TIMEOUT_SECONDS=120
# §18/§29: el nivel rojo NO pasa por el modelo. Este timeout es el que
# dispara el fallback a plantilla fija en naranja/amarillo/verde.
SENTI_LLM_QUEUE_MAX_DEPTH=32

# Embeddings — nomic-embed-text-v1.5 (bundled en LM Studio), 768 dims.
SENTI_EMBEDDING_BASE_URL=http://llama-embed-cpu:1235/v1
SENTI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
SENTI_EMBEDDING_DIM=768

# Rutas de los GGUF en el host, para el perfil llm-cuda.
# Detectadas de tu instalación de LM Studio.
LMSTUDIO_MODELS_DIR=/home/andresqc/.lmstudio/models
LLAMACPP_MODEL_PATH=/models/lmstudio-community/gemma-4-E4B-it-GGUF/gemma-4-E4B-it-Q4_K_M.gguf
LLAMACPP_MMPROJ_PATH=/models/lmstudio-community/gemma-4-E4B-it-GGUF/mmproj-gemma-4-E4B-it-BF16.gguf
LLAMACPP_NGL=99
LLAMACPP_CTX=32768

# ─────────────────────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=senti
POSTGRES_PASSWORD=cambiame_en_produccion
POSTGRES_DB=senti
SENTI_DATABASE_URL=postgresql+psycopg://senti:cambiame_en_produccion@db:5432/senti

# Valkey (cola y caché)
SENTI_VALKEY_URL=redis://valkey:6379/0

# ─────────────────────────────────────────────────────────────
# Geoespacial
# ─────────────────────────────────────────────────────────────
SENTI_VALHALLA_URL=http://valhalla:8002
# Extracto OSM del piloto: de aquí salen las teselas de Valhalla y el mapa
# base. Perú completo pesa ~250 MB y cubre de sobra Lurigancho-Chosica.
OSM_PBF_URL=https://download.geofabrik.de/south-america/peru-latest.osm.pbf
# §20.1: exclude_polygons es caro por petición; se dimensiona al tamaño
# típico de cierre de la zona piloto.
SENTI_MAX_EXCLUDE_POLYGONS=8

# ─────────────────────────────────────────────────────────────
# Seguridad (§28)
# ─────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
SENTI_SECRET_KEY=cambiame_openssl_rand_hex_32
# Clave de cifrado en reposo del perfil del hogar (§13.2, §28).
# Generar con: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SENTI_FIELD_ENCRYPTION_KEY=
# Sal para seudonimizar teléfonos (§13.5).
SENTI_PHONE_HASH_SALT=cambiame_tambien
SENTI_ACCESS_TOKEN_MINUTES=60

# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API (§10.1) — vacío = canal deshabilitado
# ─────────────────────────────────────────────────────────────
# WhatsApp por Evolution API (§10.1). En false el webhook devuelve 503: un
# canal de emergencia a medio configurar que traga mensajes y no contesta es
# peor que uno que declara que no está disponible.
SENTI_WHATSAPP_ENABLED=false
SENTI_EVOLUTION_API_URL=
SENTI_EVOLUTION_INSTANCE=mi_bot
SENTI_EVOLUTION_API_KEY=
# Evolution NO firma sus peticiones. Sin este secreto compartido, cualquiera
# que descubra la URL del webhook puede inyectar mensajes y hacer que SENTI
# escriba a quien él diga, con tu número. Genéralo largo:
#   openssl rand -hex 32
SENTI_WHATSAPP_WEBHOOK_TOKEN=

# ─────────────────────────────────────────────────────────────
# Operación
# ─────────────────────────────────────────────────────────────
SENTI_ENV=development
SENTI_LOG_LEVEL=INFO
SENTI_PILOT_DISTRICT=Lurigancho-Chosica
SENTI_SOURCE_HEALTHCHECK_MINUTES=15

# ── Servidor sin GPU (perfil llm-cpu) ────────────────────────
# Un solo modelo para todo: chat, imágenes (§25), extracción de alertas (§15)
# y categorización de reportes (§21.1). Copia los GGUF a ./modelos.
#
# Hubo dos, "repartidos por latencia". El reparto no existía: los dos GGUF
# eran enlaces al mismo archivo, así que llama.cpp cargaba el mismo modelo dos
# veces y los procesos competían por los mismos núcleos.
LLM_MODELS_DIR=./modelos
LLAMACPP_MODEL_PATH_CPU=/models/gemma-4-E4B-it-Q4_K_M.gguf
LLAMACPP_MMPROJ_CPU=/models/mmproj-gemma-4-E4B-it-BF16.gguf
LLAMACPP_EMBED_PATH_CPU=/models/nomic-embed-text-v1.5.Q4_K_M.gguf
# 8192 por petición: en CPU el contexto se paga en cada token generado, por eso
# se prioriza una sola solicitud larga antes que partir la ventana entre slots.
LLAMACPP_CTX_CPU=16384
LLAMACPP_PARALLEL=2
# Cuantización de la caché KV. Generar está limitado por ancho de banda de
# memoria y la KV es lo que más se lee por ficha: a q8_0 ocupa la mitad y se
# midió +8,6 % de velocidad. `f16` si alguna vez sobra memoria y falta calidad.
LLAMACPP_CACHE_TYPE=q8_0
# Lote lógico al leer el prompt. Va con --ubatch-size, que es el físico.
LLAMACPP_BATCH=2048

# ── Tareas de análisis ───────────────────────────────────────
# Mismo servidor que el chat; solo cambian los límites, porque describir una
# foto necesita más fichas y más paciencia que contestar en un chat.
SENTI_LLM_DEEP_BASE_URL=http://llama-cpu:1234/v1
SENTI_LLM_DEEP_MODEL=google/gemma-4-e4b
SENTI_LLM_DEEP_MAX_TOKENS=512
# Generar está limitado por ancho de banda de memoria: tantos hilos como
# núcleos FÍSICOS (no lógicos). Más que eso empeora.
LLAMACPP_THREADS=4
# Leer el prompt sí es cómputo puro y escala con hilos: aquí van todos los
# lógicos. El prompt del sistema son ~795 fichas que se pagan en cada mensaje.
LLAMACPP_THREADS_BATCH=8
LLAMACPP_UBATCH=1024
